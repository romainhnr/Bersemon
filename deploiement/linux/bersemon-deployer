#!/bin/bash
# Déploie une version du bot Discord sur la VM : récupère le commit, le
# compile en release et redémarre le service de l'environnement.
#
# Usage, en root : bersemon-deployer <prod|dev> [commit]
# Sans commit, déploie le dernier commit de la branche de l'environnement.
#
# Lancé par GitHub Actions à travers le compte deploiement (commande forcée
# bersemon-deploiement-ssh puis sudo), ou à la main par l'administrateur.
# Installé dans /usr/local/sbin par installer-vm.sh : un push ne le modifie
# jamais, sinon une fusion dans dev suffirait à exécuter du code en root.
# Voir docs/deploiement.md.

set -euo pipefail
umask 022

readonly RACINE=/srv/bersemon
readonly RUSTUP_HOME=/opt/rust/rustup
readonly RUSTUP=/opt/rust/cargo/bin/rustup
readonly CHEMIN_SYSTEME=/usr/local/bin:/usr/bin:/bin
readonly DELAI_DE_CONNEXION=90
readonly MESSAGE_CONNECTE="Bersemon est connecté à Discord."

echec() {
    echo "Déploiement refusé : $*" >&2
    exit 1
}

[[ $EUID -eq 0 ]] || echec "ce script doit être lancé en root."
[[ $# -ge 1 && $# -le 2 ]] || echec "usage : bersemon-deployer <prod|dev> [commit]."

readonly ENVIRONNEMENT=$1
COMMIT=${2:-}

# La branche se déduit de l'environnement ici, et non de la commande reçue :
# une clé de déploiement volée ne peut déployer en prod que des commits déjà
# fusionnés dans master.
case "$ENVIRONNEMENT" in
    prod) readonly BRANCHE=master ;;
    dev) readonly BRANCHE=dev ;;
    *) echec "environnement inconnu \"$ENVIRONNEMENT\", prod ou dev attendu." ;;
esac
if [[ -n $COMMIT && ! $COMMIT =~ ^[0-9a-f]{40}$ ]]; then
    echec "\"$COMMIT\" n'est pas un identifiant de commit complet."
fi

readonly UTILISATEUR="bersemon-$ENVIRONNEMENT"
readonly SERVICE="bersemon-$ENVIRONNEMENT"
readonly DOSSIER="$RACINE/$ENVIRONNEMENT"
readonly CODE="$DOSSIER/code"
readonly BINAIRE="$DOSSIER/bin/bersemon-discord"
readonly REGLAGES="/etc/bersemon/$ENVIRONNEMENT.env"

[[ -d $CODE/.git ]] || echec "$CODE n'est pas un clone du dépôt : lancer installer-vm.sh."
[[ -f $REGLAGES ]] || echec "$REGLAGES est absent : lancer installer-vm.sh."

# Deux déploiements du même environnement ne se chevauchent pas ; prod et dev
# restent indépendants.
exec 9>"/run/lock/bersemon-deploiement-$ENVIRONNEMENT.lock"
flock --wait 1800 9 || echec "un autre déploiement de $ENVIRONNEMENT est toujours en cours."

chemin_de_compilation=$CHEMIN_SYSTEME

# Git et cargo tournent sous le compte de l'environnement, avec un
# environnement minimal : le code compilé, build.rs des dépendances compris,
# n'accède qu'aux fichiers de cet environnement.
en_tant_que_service() {
    runuser -u "$UTILISATEUR" -- env -i \
        HOME="$DOSSIER" \
        PATH="$chemin_de_compilation" \
        LANG=C.UTF-8 \
        CARGO_HOME="$DOSSIER/cargo" \
        GIT_TERMINAL_PROMPT=0 \
        "$@"
}

cd "$CODE"

echo "Récupération de la branche $BRANCHE pour $ENVIRONNEMENT."
en_tant_que_service git fetch --quiet origin "+refs/heads/$BRANCHE:refs/remotes/origin/$BRANCHE"
if [[ -z $COMMIT ]]; then
    COMMIT=$(en_tant_que_service git rev-parse "refs/remotes/origin/$BRANCHE")
fi
if ! en_tant_que_service git cat-file -e "$COMMIT^{commit}" 2>/dev/null \
    || ! en_tant_que_service git merge-base --is-ancestor "$COMMIT" "refs/remotes/origin/$BRANCHE"; then
    echec "le commit $COMMIT n'appartient pas à la branche $BRANCHE."
fi
en_tant_que_service git checkout --quiet --force --detach "$COMMIT"

# La toolchain suit la rust-version du workspace, comme la CI. La valeur vient
# du dépôt : elle est vérifiée avant d'être passée à rustup, qui ne télécharge
# que des versions officielles.
version_rust=$(sed -n 's/^rust-version = "\([^"]*\)"$/\1/p' Cargo.toml | head -n 1)
[[ $version_rust =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] \
    || echec "rust-version illisible dans Cargo.toml : \"$version_rust\"."
if ! RUSTUP_HOME=$RUSTUP_HOME "$RUSTUP" which --toolchain "$version_rust" cargo >/dev/null 2>&1; then
    echo "Installation de Rust $version_rust."
    RUSTUP_HOME=$RUSTUP_HOME CARGO_HOME=/opt/rust/cargo \
        "$RUSTUP" toolchain install "$version_rust" --profile minimal
fi
cargo_de_la_toolchain=$(RUSTUP_HOME=$RUSTUP_HOME "$RUSTUP" which --toolchain "$version_rust" cargo)
# Les binaires de la toolchain sont appelés directement, sans les proxys de
# rustup : le compte de l'environnement n'a pas à écrire dans /opt/rust.
chemin_de_compilation="$(dirname "$cargo_de_la_toolchain"):$CHEMIN_SYSTEME"

echo "Compilation de $COMMIT avec Rust $version_rust."
en_tant_que_service cargo build --release --locked -p bersemon-discord

# Le binaire précédent est gardé pour revenir en arrière si le nouveau ne se
# connecte pas.
if [[ -f $BINAIRE ]]; then
    cp --preserve=mode,ownership,timestamps "$BINAIRE" "$BINAIRE.precedent"
    if [[ -f $DOSSIER/bin/version ]]; then
        cp --preserve=mode,ownership "$DOSSIER/bin/version" "$DOSSIER/bin/version.precedent"
    fi
fi
install -o "$UTILISATEUR" -g "$UTILISATEUR" -m 0755 \
    "$CODE/target/release/bersemon-discord" "$BINAIRE.nouveau"
mv -f "$BINAIRE.nouveau" "$BINAIRE"
echo "$COMMIT" >"$DOSSIER/bin/version"
chown "$UTILISATEUR:$UTILISATEUR" "$DOSSIER/bin/version"

if ! grep -Eq '^DISCORD_TOKEN=.+' "$REGLAGES"; then
    echo "Binaire installé, mais le service n'est pas redémarré : DISCORD_TOKEN est vide dans $REGLAGES." >&2
    exit 1
fi

# Un redémarrage fait perdre les expéditions en cours : chaque joueur reprend
# à sa dernière sauvegarde (section 13.9 de docs/gamedesign.md).
debut=$(date +%s)
systemctl restart "$SERVICE"

connecte() {
    journalctl --unit "$SERVICE" --since "@$1" --output cat --no-pager 2>/dev/null \
        | grep -qF "$MESSAGE_CONNECTE"
}

for _ in $(seq "$DELAI_DE_CONNEXION"); do
    if connecte "$debut"; then
        echo "Déploiement de $ENVIRONNEMENT terminé : $COMMIT."
        exit 0
    fi
    sleep 1
done

echo "Le bot ne s'est pas connecté à Discord en $DELAI_DE_CONNEXION s. Derniers messages :" >&2
journalctl --unit "$SERVICE" --since "@$debut" --output cat --no-pager -n 30 >&2 || true

# Un binaire qui ne s'est jamais connecté n'a enregistré aucune partie : le
# précédent peut reprendre sans risque de lire un format de sauvegarde plus
# récent que le sien.
if [[ -f $BINAIRE.precedent ]]; then
    mv -f "$BINAIRE.precedent" "$BINAIRE"
    if [[ -f $DOSSIER/bin/version.precedent ]]; then
        mv -f "$DOSSIER/bin/version.precedent" "$DOSSIER/bin/version"
    fi
    systemctl restart "$SERVICE"
    echo "Retour au binaire précédent ($(cat "$DOSSIER/bin/version" 2>/dev/null || echo "version inconnue"))." >&2
fi
exit 1
