# Réglages du bot Bersemon (@ENV@), lus par le service bersemon-@ENV@.
# Ce fichier contient le jeton : il n'est lisible que par le compte
# bersemon-@ENV@ (et root) et ne doit jamais être copié dans le dépôt.
# Modifier avec : sudoedit /etc/bersemon/@ENV@.env
# Puis appliquer avec : sudo systemctl restart bersemon-@ENV@

# Jeton du bot, onglet Bot du portail développeur Discord (docs/discord.md).
DISCORD_TOKEN=

# Dossier des parties. Ne pas changer : le service n'a le droit d'écrire que
# là, et refuse de démarrer si la valeur est différente.
BERSEMON_DONNEES=/srv/bersemon/@ENV@/parties

# Facultatif, pour le bot de test seulement : identifiant du serveur de test,
# où les commandes apparaissent tout de suite, mais seulement là.
#BERSEMON_SERVEUR_DE_TEST=

# Facultatif, pour les tests à plusieurs : /bersemon répond par un message
# visible de tout le salon.
#BERSEMON_MESSAGES_PUBLICS=1
